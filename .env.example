# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#   docker compose up --build
#

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the PostgreSQL user. Choose something strong in production.
POSTGRES_PASSWORD=change_me_in_production

# ── API server ────────────────────────────────────────────────────────────────
# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_in_production

# Gemini API key — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Networking (optional) ─────────────────────────────────────────────────────
# Host port that nginx binds to. Defaults to 80.
# HOST_PORT=8080
