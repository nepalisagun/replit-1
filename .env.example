# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#   docker compose up --build
#

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the PostgreSQL user. Choose something strong in production.
POSTGRES_PASSWORD=change_me_in_production

# ── API server ────────────────────────────────────────────────────────────────
# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_in_production

# Gemini API key — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Networking (optional) ─────────────────────────────────────────────────────
# Host port that nginx binds to. Defaults to 80.
# HOST_PORT=8080

# ── Production deployment (docker-compose.prod.yml only) ──────────────────────
# GitHub repository slug — controls which ghcr.io package is pulled.
# Defaults to nepalisagun/replit-1 if unset.
# GITHUB_REPOSITORY=nepalisagun/replit-1

# Image tag to deploy. Defaults to "latest". Pin to a version for stability.
# RELEASE_TAG=1.2.3

# ── Watchtower notifications (optional) ───────────────────────────────────────
# shoutrrr-formatted URL. Leave unset to disable all notifications.
#
# Slack incoming webhook:
#   WATCHTOWER_NOTIFICATION_URL=generic+https://hooks.slack.com/services/T.../B.../xxx
#
# Discord webhook:
#   WATCHTOWER_NOTIFICATION_URL=discord://TOKEN@CHANNEL_ID
#
# Generic HTTP endpoint (n8n, Zapier, custom):
#   WATCHTOWER_NOTIFICATION_URL=generic+https://your-server.com/hook
#
# Multiple destinations (space-separated):
#   WATCHTOWER_NOTIFICATION_URL=discord://... generic+https://...
#
# WATCHTOWER_NOTIFICATION_URL=
